# Quant Platform Configuration
QUANT_DATA_DIR=./data_store
QUANT_DUCKDB_PATH=./data_store/quant_research.duckdb
QUANT_LOG_LEVEL=INFO
QUANT_DEFAULT_BASE_CURRENCY=AUD

# Tax & Market Assumptions
QUANT_AU_CORPORATE_TAX_RATE=0.30
QUANT_US_DIVIDEND_WITHHOLDING_TAX=0.15
QUANT_DEFAULT_COMMISSION_BPS=8.0
QUANT_DEFAULT_SLIPPAGE_BPS=5.0

# AI Research Agent Configuration (Optional - uses deterministic fallback if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# External Data API Keys (Optional)
FRED_API_KEY=
SEC_EDGAR_USER_AGENT="QuantResearchPlatform research@example.com"
